---
import '../styles/bridgevoice-reset.css';
import '../styles/searchatlas-theme.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Search Atlas Theme Demo</title>
  </head>
  <body>
    <main style="max-width: 1200px; margin: 0 auto; padding: var(--space-xl);">

      <!-- Nav -->
      <nav style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-md) 0; margin-bottom: var(--space-2xl);">
        <span style="font-size: var(--text-h3); font-weight: var(--font-display); color: var(--color-text-primary);">
          🔍 SearchAtlas
        </span>
        <div style="display: flex; gap: var(--space-lg); align-items: center;">
          <a href="#" style="color: var(--color-text-secondary); text-decoration: none; font-size: var(--text-small);">Tools</a>
          <a href="#" style="color: var(--color-text-secondary); text-decoration: none; font-size: var(--text-small);">Pricing</a>
          <a href="#" style="color: var(--color-text-secondary); text-decoration: none; font-size: var(--text-small);">Resources</a>
          <button class="btn btn-primary" style="padding: var(--space-xs) var(--space-md); font-size: var(--text-small);">
            Start Free Trial
          </button>
        </div>
      </nav>

      <!-- Hero -->
      <section style="text-align: center; padding: var(--space-2xl) 0;">
        <h1 style="font-size: var(--text-display); margin-bottom: var(--space-md); line-height: 1.1;">
          Scale Your Marketing<br/>Without Scaling Your Team
        </h1>
        <p style="font-size: var(--text-h3); color: var(--color-text-secondary); max-width: 600px; margin: 0 auto var(--space-lg);">
          The all-in-one SEO platform. AI-powered tools, rank tracking,
          content optimization, and white-label solutions.
        </p>
        <div style="display: flex; gap: var(--space-md); justify-content: center; margin-bottom: var(--space-lg);">
          <button class="btn btn-primary" style="padding: var(--space-sm) var(--space-xl);">Try For Free</button>
          <button class="btn btn-secondary" style="padding: var(--space-sm) var(--space-xl);">Watch Demo</button>
        </div>
        <!-- Logo bar -->
        <div style="display: flex; gap: var(--space-xl); justify-content: center; align-items: center; opacity: 0.4; margin-top: var(--space-xl);">
          <span style="font-size: var(--text-small); color: var(--color-text-tertiary);">Trusted by teams at</span>
          <span style="font-weight: var(--font-bold); color: var(--color-text-tertiary);">Shopify</span>
          <span style="font-weight: var(--font-bold); color: var(--color-text-tertiary);">EOS</span>
          <span style="font-weight: var(--font-bold); color: var(--color-text-tertiary);">P&G</span>
          <span style="font-weight: var(--font-bold); color: var(--color-text-tertiary);">Deloitte</span>
        </div>
      </section>

      <!-- AI Feature Card -->
      <section style="margin-bottom: var(--space-2xl);">
        <div class="card" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: center;">
          <div>
            <span class="badge" style="border: 1px solid var(--color-brand); color: var(--color-brand); margin-bottom: var(--space-md); display: inline-block;">AI-Powered</span>
            <h2 style="margin-bottom: var(--space-sm);">Let Your SEO Work Smarter, Not Harder with AI</h2>
            <p style="color: var(--color-text-secondary); font-size: var(--text-small);">
              OTTO SEO is the number one search engine tool in the world.
              After 15 years in SEO, it's a game-changer. Other tools are overhyped.
            </p>
          </div>
          <div style="background: var(--color-surface-muted); border-radius: var(--radius-base); padding: var(--space-lg); text-align: center;">
            <div style="font-size: 48px; margin-bottom: var(--space-sm);">🤖</div>
            <div style="color: var(--color-brand); font-weight: var(--font-bold);">OTTO SEO</div>
          </div>
        </div>
      </section>

      <!-- Stats Section -->
      <section style="text-align: center; margin-bottom: var(--space-2xl);">
        <h2 style="margin-bottom: var(--space-xs);">Real Results. Real Fast.</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-lg); font-size: var(--text-small);">
          Why buy 5 SEO tools when 1 will do the work?
        </p>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg);">
          <div class="card" style="text-align: center; border: 1px solid rgba(45,212,191,0.2);">
            <div style="font-size: var(--text-display); font-weight: var(--font-display); color: var(--color-brand); line-height: 1;">97%</div>
            <div style="font-size: 24px; color: var(--color-brand);">↗</div>
            <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Avg. Ranking Improvement</div>
          </div>
          <div class="card" style="text-align: center; border: 1px solid rgba(45,212,191,0.2);">
            <div style="font-size: var(--text-display); font-weight: var(--font-display); color: var(--color-brand); line-height: 1;">390x</div>
            <div style="font-size: 24px; color: var(--color-brand);">↗</div>
            <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Traffic Growth</div>
          </div>
          <div class="card" style="text-align: center; border: 1px solid rgba(45,212,191,0.2);">
            <div style="font-size: var(--text-display); font-weight: var(--font-display); color: var(--color-brand); line-height: 1;">96%</div>
            <div style="font-size: 24px; color: var(--color-brand);">↗</div>
            <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Client Satisfaction</div>
          </div>
        </div>
      </section>

      <!-- Pricing Section -->
      <section style="margin-bottom: var(--space-2xl);">
        <h2 style="text-align: center; margin-bottom: var(--space-xs);">Choose The Plan You Would Like to Try</h2>
        <p style="text-align: center; color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-lg);">
          No matter your growth stage, OTTO has a plan for you.
        </p>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg);">
          <!-- Starter -->
          <div class="card">
            <h3 style="margin-bottom: var(--space-xs);">Starter</h3>
            <div style="margin-bottom: var(--space-md);">
              <span style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-text-primary);">$99</span>
              <span style="color: var(--color-text-tertiary); font-size: var(--text-small);">/month</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: var(--space-lg);">
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> 500 Keywords
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> Site Audits
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> AI Content Writer
              </li>
            </ul>
            <button class="btn btn-secondary" style="width: 100%;">Get Started</button>
          </div>
          <!-- Growth (Featured) -->
          <div class="card" style="border: 1px solid var(--color-brand); position: relative;">
            <span class="badge" style="background: var(--color-brand); color: var(--color-surface-canvas); position: absolute; top: -10px; left: 50%; transform: translateX(-50%);">Most Popular</span>
            <h3 style="margin-bottom: var(--space-xs);">Growth</h3>
            <div style="margin-bottom: var(--space-md);">
              <span style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-text-primary);">$179</span>
              <span style="color: var(--color-text-tertiary); font-size: var(--text-small);">/month</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: var(--space-lg);">
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> 2,000 Keywords
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> OTTO SEO AI Agent
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> White-Label Reports
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> Competitor Analysis
              </li>
            </ul>
            <button class="btn btn-primary" style="width: 100%;">Start Free Trial</button>
          </div>
          <!-- Pro -->
          <div class="card">
            <h3 style="margin-bottom: var(--space-xs);">Pro</h3>
            <div style="margin-bottom: var(--space-md);">
              <span style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-text-primary);">$299</span>
              <span style="color: var(--color-text-tertiary); font-size: var(--text-small);">/month</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: var(--space-lg);">
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> 10,000 Keywords
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> Unlimited AI Content
              </li>
              <li style="color: var(--color-text-secondary); font-size: var(--text-small); padding: var(--space-xs) 0;">
                <span style="color: var(--color-brand);">✓</span> API Access
              </li>
            </ul>
            <button class="btn btn-secondary" style="width: 100%;">Get Started</button>
          </div>
        </div>
      </section>

      <!-- Tools Grid -->
      <section style="margin-bottom: var(--space-2xl);">
        <h2 style="text-align: center; margin-bottom: var(--space-xs);">Everything Your Agency Needs to Win</h2>
        <p style="text-align: center; color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-lg);">
          OTTO BRAND PARTNERS is a full suite: reporting, AI content, backlink management, rank tracking.
        </p>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md);">
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">📊</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">OTTO Analytics</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">✍️</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">AI Writer</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">🔗</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">Backlink Manager</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">📈</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">Rank Tracker</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">🔍</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">Site Auditor</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">📋</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">White-Label</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">🤖</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">OTTO SEO</div>
          </div>
          <div class="card" style="text-align: center; padding: var(--space-md);">
            <div style="font-size: 24px; margin-bottom: var(--space-xs);">🎯</div>
            <div style="font-size: var(--text-small); font-weight: var(--font-bold);">Google Ads AI</div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section style="margin-bottom: var(--space-2xl); max-width: 700px; margin-left: auto; margin-right: auto;">
        <h2 style="text-align: center; margin-bottom: var(--space-lg);">Frequently Asked Questions</h2>
        <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
          <div class="card" style="cursor: pointer;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: var(--font-bold);">What is Search Atlas?</span>
              <span style="color: var(--color-brand);">+</span>
            </div>
          </div>
          <div class="card" style="cursor: pointer;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: var(--font-bold);">Is Search Atlas right for my agency?</span>
              <span style="color: var(--color-brand);">+</span>
            </div>
          </div>
          <div class="card" style="cursor: pointer;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: var(--font-bold);">How does Search Atlas work?</span>
              <span style="color: var(--color-brand);">+</span>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section style="background: linear-gradient(135deg, rgba(45,212,191,0.1), rgba(30,30,63,0.8)); border: 1px solid var(--color-border); border-radius: var(--radius-base); padding: var(--space-2xl); text-align: center; margin-bottom: var(--space-2xl);">
        <h2 style="font-size: var(--text-h1); margin-bottom: var(--space-sm);">
          10x Your Agency Revenue with<br/>White-Label SEO Solutions
        </h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-lg);">
          Get $5000 worth of tools for $99/month.
        </p>
        <button class="btn btn-primary" style="padding: var(--space-sm) var(--space-xl); font-size: var(--text-body);">
          Start Free Trial
        </button>
      </section>

      <!-- Footer -->
      <footer style="text-align: center; padding: var(--space-xl) 0; color: var(--color-text-tertiary); font-size: var(--text-small); border-top: 1px solid var(--color-border);">
        Generated by Style Set — Screenshot to Astro Theme in seconds.
      </footer>

    </main>
  </body>
</html>
