---
import '../styles/bridgevoice-reset.css';
import '../styles/blowfish-theme.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>Blowfish 01</title>
    <style>
      .huge { font-size: clamp(48px, 8vw, 80px); font-weight: 800; line-height: 0.95; text-transform: uppercase; }
      .outline-btn {
        display: inline-flex; align-items: center; gap: 12px;
        padding: 16px 36px;
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        font-size: 13px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 3px;
        cursor: pointer; background: transparent;
        transition: 0.2s; text-decoration: none;
      }
      .outline-btn:hover { border-color: var(--color-brand); color: var(--color-brand); }
      .nav-link {
        color: var(--color-text-secondary); text-decoration: none;
        font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px;
        font-weight: 500; transition: 0.2s;
      }
      .nav-link:hover { color: var(--color-text-primary); }
      .spec-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-md) 0;
        border-bottom: 1px solid var(--color-border-subtle);
      }
      .counter { font-size: var(--text-small); color: var(--color-text-tertiary); }
    </style>
  </head>
  <body>

    <!-- Nav -->
    <nav style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-md) var(--space-xl); position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10,10,10,0.9); backdrop-filter: blur(10px);">
      <span style="font-size: var(--text-small); font-weight: 700; text-transform: uppercase; letter-spacing: 4px;">Blowfish.01</span>
      <div style="display: flex; gap: var(--space-xl);">
        <a href="#" class="nav-link">Innovation</a>
        <a href="#" class="nav-link">About</a>
        <a href="#" class="nav-link">Catalog</a>
        <a href="#" class="nav-link">Contacts</a>
      </div>
    </nav>

    <!-- Hero -->
    <section style="min-height: 100vh; display: flex; align-items: center; padding: 0 var(--space-xl); position: relative;">
      <div style="max-width: 600px; z-index: 1;">
        <h1 class="huge" style="margin-bottom: var(--space-lg);">
          The <span style="color: var(--color-brand);">Future</span><br/>
          of Two-Wheel<br/>
          Thrills
        </h1>
        <p style="color: var(--color-text-secondary); font-size: var(--text-body); margin-bottom: var(--space-xl); max-width: 320px; line-height: 1.7;">
          Begin your journey to unforgettable moments and healthy, active lifestyles.
        </p>
        <a href="#specs" class="outline-btn">
          <span style="color: var(--color-brand); font-size: 18px;">↗</span>
          More Details
        </a>
      </div>

      <!-- Bike visual placeholder -->
      <div style="position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 55%; height: 80%; display: flex; align-items: center; justify-content: center;">
        <div style="font-size: 200px; opacity: 0.8;">🚲</div>
      </div>

      <!-- Bottom bar -->
      <div style="position: absolute; bottom: var(--space-xl); left: var(--space-xl); right: var(--space-xl); display: flex; justify-content: space-between; align-items: center;">
        <span class="counter">1 — 6</span>
        <div style="display: flex; align-items: center; gap: var(--space-sm); color: var(--color-text-secondary); font-size: var(--text-small);">
          NEXT <span style="color: var(--color-brand);">→</span>
        </div>
      </div>
    </section>

    <!-- Specs Section -->
    <section id="specs" style="padding: var(--space-2xl) var(--space-xl); max-width: 900px; margin: 0 auto;">
      <h2 class="huge" style="font-size: 48px; margin-bottom: var(--space-2xl);">
        Built for <span style="color: var(--color-brand);">Speed</span>
      </h2>

      <div class="spec-row">
        <div>
          <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Frame</h3>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-small);">Full carbon monocoque, aero-optimized</p>
        </div>
        <span style="font-size: var(--text-h2); font-weight: 800; color: var(--color-brand);">780g</span>
      </div>

      <div class="spec-row">
        <div>
          <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Drivetrain</h3>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-small);">Electronic shifting, 12-speed</p>
        </div>
        <span style="font-size: var(--text-h2); font-weight: 800; color: var(--color-brand);">12s</span>
      </div>

      <div class="spec-row">
        <div>
          <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Wheels</h3>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-small);">60mm deep carbon clincher, tubeless ready</p>
        </div>
        <span style="font-size: var(--text-h2); font-weight: 800; color: var(--color-brand);">60mm</span>
      </div>

      <div class="spec-row">
        <div>
          <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Top Speed</h3>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-small);">Wind tunnel tested aerodynamics</p>
        </div>
        <span style="font-size: var(--text-h2); font-weight: 800; color: var(--color-brand);">65km/h</span>
      </div>

      <div class="spec-row" style="border-bottom: none;">
        <div>
          <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Total Weight</h3>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-small);">Complete build, race-ready</p>
        </div>
        <span style="font-size: var(--text-h2); font-weight: 800; color: var(--color-brand);">6.8kg</span>
      </div>
    </section>

    <!-- Models -->
    <section style="padding: var(--space-2xl) var(--space-xl); background: var(--color-surface-base);">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 class="huge" style="font-size: 48px; margin-bottom: var(--space-2xl);">
          The <span style="color: var(--color-brand);">Lineup</span>
        </h2>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--color-border-subtle);">
          <div style="padding: var(--space-xl); border-right: 1px solid var(--color-border-subtle); text-align: center;">
            <div style="font-size: 64px; margin-bottom: var(--space-md);">🏎️</div>
            <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: var(--space-xs);">Aero Pro</h3>
            <p style="color: var(--color-text-tertiary); font-size: var(--text-small); margin-bottom: var(--space-md);">Time trial specialist</p>
            <span style="color: var(--color-brand); font-size: var(--text-h2); font-weight: 800;">$8,900</span>
          </div>
          <div style="padding: var(--space-xl); border-right: 1px solid var(--color-border-subtle); text-align: center;">
            <div style="font-size: 64px; margin-bottom: var(--space-md);">🚴</div>
            <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: var(--space-xs);">Road Elite</h3>
            <p style="color: var(--color-text-tertiary); font-size: var(--text-small); margin-bottom: var(--space-md);">All-around performer</p>
            <span style="color: var(--color-brand); font-size: var(--text-h2); font-weight: 800;">$6,400</span>
          </div>
          <div style="padding: var(--space-xl); text-align: center;">
            <div style="font-size: 64px; margin-bottom: var(--space-md);">⛰️</div>
            <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: var(--space-xs);">Gravel X</h3>
            <p style="color: var(--color-text-tertiary); font-size: var(--text-small); margin-bottom: var(--space-md);">Adventure ready</p>
            <span style="color: var(--color-brand); font-size: var(--text-h2); font-weight: 800;">$5,200</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="padding: var(--space-2xl) var(--space-xl); text-align: center;">
      <h2 class="huge" style="font-size: 48px; margin-bottom: var(--space-lg);">
        Ride the <span style="color: var(--color-brand);">Future</span>
      </h2>
      <a href="#" class="outline-btn" style="font-size: 15px;">
        <span style="color: var(--color-brand); font-size: 20px;">↗</span>
        Configure Yours
      </a>
    </section>

    <footer style="text-align: center; padding: var(--space-lg); color: var(--color-text-tertiary); font-size: var(--text-micro); border-top: 1px solid var(--color-border-subtle);">
      Generated by Style Set — Screenshot to Astro Theme in seconds.
    </footer>
  </body>
</html>
