---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main style="max-width: 1200px; margin: 0 auto; padding: var(--space-xl);">

    <!-- Hero Section -->
    <section style="text-align: center; padding: var(--space-2xl) 0;">
      <span class="badge" style="margin-bottom: var(--space-md); display: inline-block;">
        Style Set Theme Demo
      </span>
      <h1 style="font-size: var(--text-display); margin-bottom: var(--space-md);">
        From Screenshot to<br/>
        <span style="color: var(--color-brand);">Astro Theme</span> in Seconds
      </h1>
      <p style="font-size: var(--text-h3); color: var(--color-text-secondary); max-width: 600px; margin: 0 auto var(--space-lg);">
        This entire page is styled using CSS custom properties extracted from Elementor.com's design system. Zero manual CSS.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center;">
        <a href="#components" class="btn btn-primary" style="padding: var(--space-sm) var(--space-xl); font-size: var(--text-body);">
          See Components
        </a>
        <a href="#tokens" class="btn btn-secondary" style="padding: var(--space-sm) var(--space-xl); font-size: var(--text-body);">
          View Tokens
        </a>
      </div>
    </section>

    <!-- Stats Bar -->
    <section style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); padding: var(--space-xl) 0; border-top: 1px solid var(--color-border-subtle); border-bottom: 1px solid var(--color-border-subtle); margin-bottom: var(--space-2xl);">
      <div style="text-align: center;">
        <div style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-brand);">8</div>
        <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Named Styles</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-brand);">24</div>
        <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Color Palettes</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: var(--text-h1); font-weight: var(--font-display); color: var(--color-brand);">13</div>
        <div style="color: var(--color-text-secondary); font-size: var(--text-small);">Files per Theme</div>
      </div>
    </section>

    <!-- Component Showcase -->
    <section id="components">
      <h2 style="margin-bottom: var(--space-lg);">Component Showcase</h2>

      <!-- Cards Grid -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); margin-bottom: var(--space-2xl);">

        <div class="card">
          <h3 style="margin-bottom: var(--space-sm);">Neomorphism</h3>
          <p style="color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-md);">
            Soft shadows, extruded surfaces. The "new skeuomorphism" that makes UI elements look physically raised from the background.
          </p>
          <span class="badge">Popular</span>
        </div>

        <div class="card">
          <h3 style="margin-bottom: var(--space-sm);">Glassmorphism</h3>
          <p style="color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-md);">
            Frosted glass effect with backdrop blur. Translucent surfaces that let background content show through softly.
          </p>
          <span class="badge">Trending</span>
        </div>

        <div class="card">
          <h3 style="margin-bottom: var(--space-sm);">Brutalism</h3>
          <p style="color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-md);">
            Hard edges, bold shadows, thick borders. Raw and unapologetic design that breaks conventional UI patterns.
          </p>
          <span class="badge">Bold</span>
        </div>
      </div>

      <!-- Buttons -->
      <h2 style="margin-bottom: var(--space-lg);">Buttons</h2>
      <div style="display: flex; gap: var(--space-md); margin-bottom: var(--space-2xl); flex-wrap: wrap; align-items: center;">
        <button class="btn btn-primary">Primary Action</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-primary" style="background: var(--color-brand-dark);">Dark Variant</button>
        <button class="btn btn-secondary" style="font-size: var(--text-small); padding: var(--space-xs) var(--space-md);">Small Button</button>
      </div>

      <!-- Form Elements -->
      <h2 style="margin-bottom: var(--space-lg);">Form Elements</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); margin-bottom: var(--space-2xl);">
        <div class="card">
          <div style="margin-bottom: var(--space-md);">
            <label style="display: block; font-size: var(--text-small); font-weight: var(--font-bold); color: var(--color-text-secondary); margin-bottom: var(--space-xs);">
              Project Name
            </label>
            <input class="input" type="text" placeholder="My Awesome Site" />
          </div>
          <div style="margin-bottom: var(--space-md);">
            <label style="display: block; font-size: var(--text-small); font-weight: var(--font-bold); color: var(--color-text-secondary); margin-bottom: var(--space-xs);">
              Email Address
            </label>
            <input class="input" type="email" placeholder="you@example.com" />
          </div>
          <button class="btn btn-primary" style="width: 100%;">Get Started</button>
        </div>

        <div class="card" style="display: flex; flex-direction: column; justify-content: center;">
          <h3 style="margin-bottom: var(--space-sm);">Set Your UI & Forget It</h3>
          <p style="color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-md);">
            Pick a style. Pick a palette. Pick a font. Export your theme.
            Drop it into any Astro project. Done.
          </p>
          <p style="color: var(--color-text-tertiary); font-size: var(--text-micro);">
            Every token, every component, every shadow — generated automatically from your design choices.
          </p>
        </div>
      </div>
    </section>

    <!-- Token Reference -->
    <section id="tokens" style="margin-bottom: var(--space-2xl);">
      <h2 style="margin-bottom: var(--space-lg);">Design Tokens</h2>
      <div class="card" style="font-family: monospace; font-size: var(--text-small); line-height: 1.8;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg);">
          <div>
            <h3 style="font-family: var(--font-sans); margin-bottom: var(--space-sm);">Colors</h3>
            <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 4px;">
              <span style="width: 16px; height: 16px; border-radius: 4px; background: var(--color-brand); display: inline-block;"></span>
              --color-brand
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 4px;">
              <span style="width: 16px; height: 16px; border-radius: 4px; background: var(--color-brand-light); display: inline-block;"></span>
              --color-brand-light
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 4px;">
              <span style="width: 16px; height: 16px; border-radius: 4px; background: var(--color-brand-dark); display: inline-block;"></span>
              --color-brand-dark
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 4px;">
              <span style="width: 16px; height: 16px; border-radius: 4px; background: var(--color-text-primary); display: inline-block;"></span>
              --color-text-primary
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: 4px;">
              <span style="width: 16px; height: 16px; border-radius: 4px; background: var(--color-text-secondary); display: inline-block;"></span>
              --color-text-secondary
            </div>
          </div>
          <div>
            <h3 style="font-family: var(--font-sans); margin-bottom: var(--space-sm);">Typography</h3>
            <div>--text-display: <span style="font-size: 20px; font-weight: var(--font-display);">56px</span></div>
            <div>--text-h1: <span style="font-weight: var(--font-heading);">40px</span></div>
            <div>--text-h2: <span style="font-weight: var(--font-heading);">28px</span></div>
            <div>--text-body: 16px</div>
            <div>--font-heading: 600</div>
            <div>--font-body: 400</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dark Section (like Elementor's bottom) -->
    <section style="background: #0A0A0A; color: white; padding: var(--space-2xl); border-radius: var(--radius-base); margin-bottom: var(--space-2xl);">
      <h2 style="margin-bottom: var(--space-md); color: white;">The Pipeline</h2>
      <p style="color: #9CA3AF; margin-bottom: var(--space-lg); max-width: 500px;">
        Screenshot → Design DNA → Unified Tokens → CSS + Tailwind + Astro Components → Installable Theme Package
      </p>
      <div style="display: flex; gap: var(--space-md);">
        <button class="btn" style="background: var(--color-brand); color: white; padding: var(--space-sm) var(--space-xl);">
          Try Style Set
        </button>
        <button class="btn" style="background: transparent; color: white; border: 1px solid rgba(255,255,255,0.2); padding: var(--space-sm) var(--space-xl);">
          View on GitHub
        </button>
      </div>
    </section>

    <!-- Footer -->
    <footer style="text-align: center; padding: var(--space-xl) 0; color: var(--color-text-tertiary); font-size: var(--text-small); border-top: 1px solid var(--color-border-subtle);">
      Generated by Style Set — Set your UI and forget it.
    </footer>

  </main>
</BaseLayout>
