# PromptFlow Configuration
# Copy this file to .env and fill in your values
# These values will auto-populate the UI fields when the app loads

# Server
PORT=3001

# ===========================================
# AUTHENTICATION (Auth0 - Enterprise)
# ===========================================
# Create account at: https://auth0.com
# 1. Create "Single Page Application"
# 2. Configure callback URLs (localhost + production)
# 3. Create API for audience identifier
# 4. Disable Sign Ups for private access

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.promptflow.local

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-random-32-char-string

# IP Whitelist (optional - comma-separated list of trusted IPs)
# These IPs bypass Auth0 login entirely (e.g., your home/office IP)
# Example: IP_WHITELIST=136.49.112.9,192.168.1.1
IP_WHITELIST=

# Neon Database (optional - for persistent storage of clients/projects)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Anthropic Claude (required for LLM generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ZeroGPT AI Detection (optional - for AI content detection)
ZEROGPT_API_KEY=your-zerogpt-key-here

# WordPress Publishing (optional - for draft publishing feature)
WP_URL=https://your-wordpress-site.com
WP_USER=your-username
WP_APP_PASSWORD=your-application-password

# Google Business Profile API (optional - for pulling GBP data)
# Create OAuth credentials at https://console.cloud.google.com
# Apply for GBP API access at https://developers.google.com/my-business/content/prereqs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gbp/oauth/callback

# Future providers (not yet implemented)
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here
# GROK_API_KEY=your-key-here
