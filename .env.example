# PromptFlow Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001

# Anthropic Claude API Key (required for backend)
# Also auto-fills the frontend form when set
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ZeroGPT AI Detection (optional)
# Auto-fills the frontend form when set
ZEROGPT_API_KEY=your-key-here

# WordPress Publishing Credentials (optional)
# Auto-fills the frontend form when set
WP_URL=https://yoursite.com
WP_USER=your-username
WP_PASSWORD=your-app-password

# Future providers (optional)
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here
# GROK_API_KEY=your-key-here
