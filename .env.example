# PromptFlow Configuration
# Copy this file to .env and fill in your values
# These values will auto-populate the UI fields when the app loads

# Server
PORT=3001

# PIN Lock (optional - leave empty to disable)
# Set a 4-6 digit PIN to protect the app
APP_PIN=

# Neon Database (optional - for persistent storage of clients/projects)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Anthropic Claude (required for LLM generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ZeroGPT AI Detection (optional - for AI content detection)
ZEROGPT_API_KEY=your-zerogpt-key-here

# WordPress Publishing (optional - for draft publishing feature)
WP_URL=https://your-wordpress-site.com
WP_USER=your-username
WP_APP_PASSWORD=your-application-password

# Future providers (not yet implemented)
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here
# GROK_API_KEY=your-key-here
