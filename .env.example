# Gemini API Key (for frontend, exposed via Vite)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (for backend proxy server)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model (optional, defaults to claude-3-sonnet-20240229)
CLAUDE_MODEL=claude-3-sonnet-20240229

# Proxy Server Port (optional, defaults to 3001)
PROXY_PORT=3001
