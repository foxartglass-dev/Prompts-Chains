# Convex Backend URL (get this from `npx convex dev`)
VITE_CONVEX_URL=https://your-project.convex.cloud

# The following secrets should be configured in the Convex Dashboard:
# https://dashboard.convex.dev

# Required for Gemini provider
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional for Claude provider
# ANTHROPIC_API_KEY=your_claude_api_key_here

# Optional for ZeroGPT AI detection
# ZEROGPT_API_KEY=your_zerogpt_api_key_here

# Optional for WordPress integration
# WP_SITE_1_URL=https://your-wordpress-site.com
# WP_SITE_1_USER=your_wp_username
# WP_SITE_1_APP_PASSWORD=your_wp_app_password
