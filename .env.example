# Gemini API Key (for frontend, exposed via Vite)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (for backend proxy server)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model (optional, defaults to claude-sonnet-4-5-20250514)
CLAUDE_MODEL=claude-sonnet-4-5-20250514

# Proxy Server Port (optional, defaults to 3001)
PROXY_PORT=3001
